# Konfig fuer usb-backup.sh
# Liegt auf dem Mac als ~/.config/usb-backup.conf (chmod 600), nie im Repo.
# Wird vom Skript per "." eingelesen, also Shell-Syntax.
#
# Nur noetig, wenn etwas vom Skript abweichen soll. Jede Variable laesst sich ueberschreiben, z. B.
# TRUENAS="root@truenas.lan"
# HA_DIR="/mnt/tank01/ha-backups"
# NEXTCLOUD_DIR="$HOME/Nextcloud"
# FOTOS_DIR="/mnt/tank01/nextcloud/userdata/gato/files/Photos"
# KEEP=3
# KUMA_URL="https://uptimekuma.example/api/push/TOKEN"   # optional, Push nach jedem Lauf
